# Python / Node 工具链缓存
.venv/
npm-cache/
node_modules/
__pycache__/

# 平台运行时数据（项目产物/refs/媒体增长物）不入库；渲染引擎源码在 ai/
# 素材库边界（docs/asset-library.md §8）：registry/模板库/catalog 种子资产追踪；
# gallery 81MB 可由 element_gallery.py 再生，不入库；media/image 与 refs/ 不追踪。
data/*
!data/library/
data/library/*
!data/library/registry/
data/library/registry/gallery/
!data/library/methods/
!data/library/media/
data/library/media/*
!data/library/media/audio/
!data/library/templates.json
!data/library/catalog.json

# OS / 编辑器
.DS_Store
Thumbs.db
*.log

# 环境变量（真实值不入库；bak 副本同罪，2026-10-28 挡）
.env
.env.bak*

# 本地构建产物
bin/
web/dist/

# 本地成片输出（可从项目 renders 再生）
videos/

# 3D 验证片渲染产物（不入库）
demo/aegis3d/renders/

# 多风格验证管线产物（style_test_harness.py 可再生）
demo/styletest/

# 部署资产整目录只留本地（脚本/编排内含服务器 IP 等敏感信息，2026-10-22 退库）
deploy/

# demo 渲染产物（mp4/抽帧）不入库
demo/custom-clips/
demo/selfvideo-frames/

# 本地构建产物（服务二进制）
server/server.exe
server/server.exe*
server/server-test.exe~
server/zcode-server.exe
server/zcode-server.exe*

# scene 原型闸媒体产物（GATE.md 有复现命令，可再生）
demo/scene-prototype/*.mp4
demo/scene-prototype/*.png
demo/scene-prototype/assets/
server/m0.exe
server/server_new.exe

# 根目录临时草稿（分析稿/调参脚本/抽帧/截图，均可再生）
tmp_*

# AGI MV 复现 demo：脚本+工程源入库；渲染/npm 缓存/分段缓存/歌曲文件不入库
demo/agi-mv-repro/project/renders/
demo/agi-mv-repro/project/.hf-seg/
demo/agi-mv-repro/project/song_full.m4a
demo/agi-mv-repro/*.wav
demo/ink-prototype/*.mp4
demo/ink-prototype/*.png

# p5.brush 画风矩阵：源码+瘦 vend 入库；渲染 PNG 种子确定性可再生（README 有命令）
demo/p5brush-sample/*.png

# 风格打样工作区:成片/原料图/参考片(可再生成或版权内容,不入库)
demo/style-samples/renders/
demo/style-samples/rawimg/
demo/style-samples/ref-video/

# 原型验证产物(可再生成,md5 证据留 GATE.md)
demo/webgl-prototype/render*.mp4
demo/webgl-prototype/[ab]_*.png

# 等轴2.5D/soft-3D 原型:依赖与渲染产物可再生成,不入库(闸记录见 memory/GATE)
demo/iso-25d/renders/
demo/iso-25d/sheet.png
demo/soft-3d/node_modules/
demo/soft-3d/renders/
demo/soft-3d/sheet.png

# web/public 本地测试上传件（浏览器手测上传接口用的样例视频，不入库）
web/public/_*.mp4

# 双实例本地数据目录（第二实例 8081 的 data/，运行时数据不入库）
data2/

# 实测证据截图/日志不入库：docs/test-result/ 只提交 md 纪要（惯例自 bbfe0f4）
docs/test-result/*/

# TypeScript 增量构建缓存（vue-tsc 产物，可再生）
web/*.tsbuildinfo

# ai/vendor 本地离线工具链（FluidSynth 二进制/音色库，大文件不入库；来源与授权见 soundfonts/README.txt，
# README 在 ignore 规则外单独追踪）
ai/vendor/*
!ai/vendor/soundfonts/
ai/vendor/soundfonts/*
!ai/vendor/soundfonts/README.txt

# BGM v2 试听串烧（可再生副产物，ai/make_bgm_v2.py --reel）
data/library/media/audio/preview_*_reel.mp3

# 风格画材包人工首单：kit 源码入库；渲染/判卷 PNG 种子确定性可再生成，不入库（同 p5brush-sample 惯例）
demo/stylekit-pixelstage/**/*.png

# 本地临时目录与杂项二进制（运行日志/接口调试草稿/未收编工具）
tmp/
server/tmp/
server/pgq.exe

# 本地数据库备份/清库脚本（PG dump 含真实数据，只住本地）
backups/
