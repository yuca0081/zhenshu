# Python / Node 工具链缓存
.venv/
npm-cache/
node_modules/
__pycache__/

# 平台运行时数据（项目产物/refs/媒体增长物）不入库；渲染引擎源码在 ai/
# 素材库边界（docs/asset-library.md §8）：registry/模板库/catalog 种子资产追踪；
# gallery 81MB 可由 element_gallery.py 再生，不入库；media/image 与 refs/ 不追踪。
data/*
!data/library/
data/library/*
!data/library/registry/
data/library/registry/gallery/
!data/library/methods/
!data/library/media/
data/library/media/*
!data/library/media/audio/
!data/library/templates.json
!data/library/catalog.json

# OS / 编辑器
.DS_Store
Thumbs.db
*.log

# 环境变量（真实值不入库）
.env

# 本地构建产物
bin/
web/dist/

# 本地成片输出（可从项目 renders 再生）
videos/

